+#[cfg(unix)]
+#[tokio::test]
+async fn synchronous_timeout_blocks_and_discards_another_hooks_rewrite() {
+    let temp = tempfile::tempdir().expect("temporary hook directory");
+    let mut timed_out = handler(temp.path(), "sleep 30");
+    timed_out.timeout_sec = 1;
+    let mut rewrite = handler(
+        temp.path(),
+        r#"printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":"echo rewritten"}}}'"#,
+    );
+    rewrite.display_order = 1;
+    let (engine, _receiver) = engine(vec![timed_out, rewrite], shell());
+
+    let outcome = run(&engine, request(temp.path())).await;
+
+    assert_eq!(
+        (
+            outcome.should_block,
+            outcome.block_reason,
+            outcome.updated_input
+        ),
+        (
+            true,
+            Some("PreToolUse hook failed: hook timed out after 1s".to_string()),
+            None,
+        )
+    );
+    assert_eq!(
+        outcome
+            .hook_events
+            .iter()
+            .map(|event| event.run.status)
+            .collect::<Vec<_>>(),
+        vec![HookRunStatus::Failed, HookRunStatus::Completed]
+    );
+    assert_eq!(
+        outcome.hook_events[0].run.entries,
+        vec![HookOutputEntry {
+            kind: HookOutputEntryKind::Error,
+            text: "hook timed out after 1s".to_string(),
+        }]
+    );
+}
