+#[cfg(unix)]
+#[tokio::test]
+async fn asynchronous_timeout_remains_advisory() {
+    let temp = tempfile::tempdir().expect("temporary hook directory");
+    let mut advisory = handler(temp.path(), "sleep 30");
+    advisory.timeout_sec = 1;
+    if let ConfiguredHandlerKind::Command { r#async, .. } = &mut advisory.kind {
+        *r#async = true;
+    }
+    let parsed = parse_completed(
+        &advisory,
+        HandlerRunResult {
+            started_at: 1,
+            completed_at: 2,
+            duration_ms: 1000,
+            exit_code: None,
+            stdout: String::new(),
+            stderr: String::new(),
+            error: Some("hook timed out after 1s".to_string()),
+        },
+        /*turn_id*/ None,
+    );
+    assert_eq!(parsed.data, PreToolUseHandlerData::default());
+    let (engine, receiver) = engine(vec![advisory], shell());
+
+    let outcome = run(&engine, request(temp.path())).await;
+
+    assert_eq!(
+        (
+            outcome.should_block,
+            outcome.block_reason,
+            outcome.updated_input
+        ),
+        (false, None, None)
+    );
+    let completed = tokio::time::timeout(Duration::from_secs(10), receiver.recv())
+        .await
+        .expect("asynchronous hook finished")
+        .expect("hook completion");
+    assert_eq!(completed.run.status, HookRunStatus::Failed);
+    assert_eq!(
+        completed.run.entries,
+        vec![HookOutputEntry {
+            kind: HookOutputEntryKind::Error,
+            text: "hook timed out after 1s".to_string(),
+        }]
+    );
+    engine.command_runtime.shutdown().await;
+}
+
+fn handler(cwd: &std::path::Path, command: &str) -> ConfiguredHandler {
+    ConfiguredHandler {
+        builtin: false,
+        event_name: HookEventName::PreToolUse,
+        matcher: Some("^Bash$".to_string()),
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: AbsolutePathBuf::try_from(cwd.join("hooks.json"))
+            .expect("absolute path")
+            .into(),
+        source: HookSource::User,
+        display_order: 0,
+        kind: ConfiguredHandlerKind::Command {
+            command: command.to_string(),
+            r#async: false,
+            env: HashMap::new(),
+        },
+    }
+}
+
+fn request(cwd: &std::path::Path) -> PreToolUseRequest {
+    PreToolUseRequest {
+        session_id: ThreadId::new(),
+        turn_id: "turn-1".to_string(),
+        subagent: None,
+        cwd: AbsolutePathBuf::try_from(cwd).expect("absolute path"),
+        transcript_path: None,
+        model: "gpt-test".to_string(),
+        permission_mode: "default".to_string(),
+        tool_name: "Bash".to_string(),
+        matcher_aliases: Vec::new(),
+        tool_use_id: "tool-call-1".to_string(),
+        tool_input: serde_json::json!({ "command": "echo original" }),
+    }
+}
+
+#[cfg(unix)]
+fn shell() -> CommandShell {
+    CommandShell {
+        program: "/bin/sh".to_string(),
+        args: vec!["-c".to_string()],
+    }
+}
+
+fn engine(
+    handlers: Vec<ConfiguredHandler>,
+    shell: CommandShell,
+) -> (
+    ClaudeHooksEngine,
+    async_channel::Receiver<HookCompletedEvent>,
+) {
+    let (sender, receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        shell,
+        Arc::new(std::env::vars_os().collect()),
+        ThreadId::new(),
+        sender,
+    );
+    let mut engine = ClaudeHooksEngine::new(
+        /*enabled*/ false,
+        /*bypass_hook_trust*/ false,
+        /*config_layer_stack*/ None,
+        Vec::new(),
+        Vec::new(),
+        runtime,
+        Arc::new(UnusedMcpExecutor),
+    );
+    engine.handlers = handlers;
+    (engine, receiver)
+}
+
+struct UnusedMcpExecutor;
+
+impl HookMcpExecutor for UnusedMcpExecutor {
+    fn execute(&self, _call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+        Box::pin(async { panic!("command hook must not invoke MCP") })
+    }
+}
