+#[test]
+fn synchronous_io_failure_ignores_partial_output_and_blocks() {
+    let temp = tempfile::tempdir().expect("temporary hook directory");
+    let parsed = parse_completed(
+        &handler(temp.path(), "echo hook"),
+        HandlerRunResult {
+            started_at: 1,
+            completed_at: 2,
+            duration_ms: 1,
+            exit_code: Some(0),
+            stdout: r#"{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":"echo rewritten"}}}"#.to_string(),
+            stderr: String::new(),
+            error: Some("failed to write hook stdin: I/O failure".to_string()),
+        },
+        /*turn_id*/ None,
+    );
+
+    assert_eq!(
+        parsed.data,
+        PreToolUseHandlerData {
+            should_block: true,
+            block_reason: Some(
+                "PreToolUse hook failed: failed to write hook stdin: I/O failure".to_string()
+            ),
+            additional_contexts_for_model: Vec::new(),
+            updated_input: None,
+        }
+    );
+    assert_eq!(parsed.completed.run.status, HookRunStatus::Failed);
+}
