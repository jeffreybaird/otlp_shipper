{
  "description": "Require human review of existing tests and verification policy changes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected edits"
          }
        ]
      }
    ]
  }
}
